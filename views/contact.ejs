<%- include('partials/header', { title: 'Contact | FoodMitra', page: 'contact' }) %>

<header class="page-hero">
  <span class="eyebrow">We'd Love to Hear From You</span>
  <h1>Contact Us</h1>
  <p>Whether you're donating, volunteering, or just curious — reach out anytime.</p>
</header>

<section class="section section-alt">
  <div class="container">
    <div class="grid grid-2" style="align-items:start;">

      <div class="card" style="text-align:left;">
        <h3 style="margin-bottom:18px;">Send a Message</h3>

        <form id="contactForm" action="/contact" method="POST">

          <label for="name">Your Name</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Your Name"
            required
          >

          <label for="email">Your Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Your Email"
            required
          >

          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Your Message"
            required
          ></textarea>

          <button
            type="submit"
            class="btn btn-primary btn-block"
            style="margin-top:22px;"
          >
            <i class="fas fa-paper-plane"></i> Send Message
          </button>

        </form>

        <p
          id="contactStatus"
          style="margin-top:14px; font-weight:600; font-size:0.9rem;"
        ></p>
      </div>


      <div class="card" style="text-align:left;">

        <h3 style="margin-bottom:18px;">Get In Touch</h3>

        <p style="margin-bottom:14px;">
          <i class="fas fa-map-marker-alt"
             style="color:var(--primary); margin-right:10px;"></i>
          Greater Noida, Uttar Pradesh
        </p>

        <p style="margin-bottom:14px;">
          <i class="fas fa-envelope"
             style="color:var(--primary); margin-right:10px;"></i>
          nayantaeyewears@gmail.com
        </p>

        <p style="margin-bottom:14px;">
          <i class="fas fa-phone-alt"
             style="color:var(--primary); margin-right:10px;"></i>
          +91 9955428948
        </p>

        <p style="margin-bottom:0;">
          <i class="fab fa-instagram"
             style="color:var(--primary); margin-right:10px;"></i>
          @foodmitra
        </p>


        <!-- Google Maps -->
        <div style="margin-top:24px; border-radius:12px; overflow:hidden;">

          <iframe
            src="https://www.google.com/maps?q=Greater+Noida,+Uttar+Pradesh&amp;z=14&amp;t=m&amp;hl=en&amp;output=embed"
            width="100%"
            height="260"
            style="border:0;"
            allowfullscreen
            loading="lazy">
          </iframe>

        </div>

      </div>

    </div>
  </div>
</section>


<script>
  document.getElementById('contactForm').addEventListener('submit', async function (e) {

    e.preventDefault();

    const form = e.target;
    const status = document.getElementById('contactStatus');

    const data = {
      name: form.name.value,
      email: form.email.value,
      message: form.message.value
    };

    try {

      const res = await fetch('/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      if (res.ok) {

        status.style.color = 'var(--success)';
        status.textContent =
          '✅ Message sent! We will get back to you soon.';

        form.reset();

      } else {

        throw new Error('Request failed');

      }

    } catch (err) {

      status.style.color = 'var(--primary)';
      status.textContent =
        '⚠️ Something went wrong. Please try again.';

    }

  });
</script>

<%- include('partials/footer') %>