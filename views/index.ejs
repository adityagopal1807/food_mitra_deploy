<%- include('partials/header', { title: 'FoodMitra — Rescue Food, Feed Lives', page: 'home' }) %>

  <header class="hero">
    <div class="hero-inner">
      <span class="hero-badge"><i class="fas fa-leaf"></i> Zero Waste, Full Hearts</span>
      <h1>Join FoodMitra to Rescue and Share Food</h1>
      <h3>Feeding People and Animals with Surplus Food</h3>
      <p>Empowering communities and animal welfare through sustainable food sharing — one donation at a time.</p>
      <div class="hero-actions">
        <a href="/account/items/new" class="btn btn-primary"><i class="fas fa-hand-holding-heart"></i> Donate Now</a>
        <a href="/listings" class="btn btn-outline"><i class="fas fa-search"></i> Find Food</a>
      </div>
    </div>
  </header>

  <section class="section section-alt" id="about">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Purpose</span>
        <h2>Why FoodMitra?</h2>
        <p>A platform built to reduce waste and increase access to food, for humans and animals alike.</p>
      </div>
      <div class="grid grid-4">
        <div class="card">
          <div class="card-icon"><i class="fas fa-seedling"></i></div>
          <h3>Sustainability</h3>
          <p>Reduce food waste and protect the environment for future generations.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-users"></i></div>
          <h3>Community Support</h3>
          <p>Help those in need by redistributing surplus food to hungry people.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-paw"></i></div>
          <h3>Animal Welfare</h3>
          <p>Feed stray animals, cows, and pets with leftover food to reduce animal hunger.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-dollar-sign"></i></div>
          <h3>Cost Savings</h3>
          <p>Access quality food at affordable prices and save money.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="how-it-works">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Simple Process</span>
        <h2>How It Works</h2>
        <p>Three easy steps connect surplus food to the people and animals who need it.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <div class="card-icon"><i class="fas fa-box-open"></i></div>
          <h3>Donate Surplus Food</h3>
          <p>Restaurants, shops, and individuals can list leftover food suitable for humans or animals.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-hand-holding-heart"></i></div>
          <h3>Connect With Communities</h3>
          <p>Verified admins and volunteers pick up listings and get them to people and animals nearby.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-truck"></i></div>
          <h3>Pickup &amp; Delivery</h3>
          <p>Food is collected and delivered timely to ensure freshness and proper distribution.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="contact">
    <div class="container text-center">
      <i class="fas fa-envelope-open-text divider-icon"></i>
      <h2>Have a Question?</h2>
      <p>Reach out to us at <a href="mailto:nayantaeyewears@gmail.com" style="color:var(--primary); font-weight:600;">nayantaeyewears@gmail.com</a> — we're happy to help.</p>
    </div>
  </section>

<%- include('partials/footer') %>
