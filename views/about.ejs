<%- include('partials/header', { title: 'About Us | FoodMitra', page: 'about' }) %>

  <header class="page-hero">
    <span class="eyebrow">Our Story</span>
    <h1>About FoodMitra</h1>
    <p>Rescuing food, feeding lives — both human and animal. Discover our mission and purpose.</p>
  </header>

  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2">
        <div class="card" style="text-align:left;">
          <div class="card-icon"><i class="fas fa-bullseye"></i></div>
          <h3>Our Mission</h3>
          <p>Our mission is to reduce food wastage and fight hunger by creating a platform that connects those with surplus food to those in need — including hungry people and animals. We promote sustainability, empathy, and community well-being.</p>
        </div>
        <div class="card" style="text-align:left;">
          <div class="card-icon"><i class="fas fa-eye"></i></div>
          <h3>Our Vision</h3>
          <p>We envision a world where no food goes to waste and every hungry mouth is fed. FoodMitra aims to be the go-to bridge between excess and need, driving change through compassion, technology, and partnerships.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Work</span>
        <h2>What We Do</h2>
        <p>From pickup to plate, we make surplus food redistribution simple and reliable.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <div class="card-icon"><i class="fas fa-utensils"></i></div>
          <h3>Connect</h3>
          <p>Connect individuals and businesses with surplus food to admins and volunteers ready to distribute it efficiently.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-truck"></i></div>
          <h3>Deliver</h3>
          <p>Enable fast pickup and delivery of food through our logistics network to ensure freshness and impact.</p>
        </div>
        <div class="card">
          <div class="card-icon"><i class="fas fa-heart"></i></div>
          <h3>Care</h3>
          <p>Ensure leftover food nourishes people and animals instead of ending up in landfills.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt text-center">
    <div class="container">
      <h2 style="margin-bottom:16px;">Ready to Make a Difference?</h2>
      <p style="max-width:560px; margin:0 auto 28px;">Whether you have surplus food to give or want to help distribute it, there's a place for you at FoodMitra.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href="/account/items/new" class="btn btn-primary"><i class="fas fa-hand-holding-heart"></i> Donate Food</a>
        <a href="/listings" class="btn btn-dark"><i class="fas fa-search"></i> Browse Listings</a>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
