<%- include('../partials/header', { title: 'Login | FoodMitra', page: 'account' }) %>

  <section class="form-shell">
    <div class="form-card">
      <h2><i class="fas fa-right-to-bracket"></i> Log In / Sign Up</h2>
      <p class="form-subtitle">No passwords here — log in with a one-time email code, or continue with Google.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><i class="fas fa-triangle-exclamation"></i> <%= error %></div>
      <% } %>
      <% if (typeof info !== 'undefined' && info) { %>
        <div class="form-success"><i class="fas fa-circle-check"></i> <%= info %></div>
      <% } %>

      <% if (googleEnabled) { %>
        <a href="/auth/google" class="btn btn-dark btn-block" style="margin-bottom: 22px;">
          <i class="fab fa-google"></i> Continue with Google
        </a>
        <div class="form-divider"><span>or use email</span></div>
      <% } %>

      <form action="/auth/otp/request" method="POST">
        <label for="name">Full Name <span style="font-weight:400; color:var(--text-light);">(only needed the first time)</span></label>
        <input type="text" id="name" name="name" placeholder="e.g. Priya Sharma">

        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>

        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-paper-plane"></i> Send Login Code</button>
      </form>

      <a class="back-link" href="/">← Back to Home</a>
    </div>
  </section>

<%- include('../partials/footer') %>
